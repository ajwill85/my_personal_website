{
  "openapi": "3.1.0",
  "info": {
    "title": "ajwill.ai Visitor Counter API",
    "version": "1.0.0",
    "description": "Public visitor counter with IP-hash deduplication. Invoked by the portfolio SPA via VITE_VISITOR_COUNTER_API (API Gateway), not via CloudFront paths on ajwill.ai."
  },
  "servers": [
    {
      "url": "https://u2pg8kjps9.execute-api.us-east-1.amazonaws.com/prod",
      "description": "API Gateway stage (from VITE_VISITOR_COUNTER_API)"
    }
  ],
  "paths": {
    "/count": {
      "get": {
        "operationId": "getVisitorCount",
        "summary": "Increment and return visitor count",
        "responses": {
          "200": {
            "description": "Current count",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "visit_type": {
                      "type": "string"
                    },
                    "is_bot": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
